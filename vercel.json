{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "personal-website-ten-pi-53.vercel.app" }],
      "destination": "https://shouryadav.info/:path",
      "permanent": true
    }
  ],
  "headers": [
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ],
  "rewrites": [
    { "source": "/blog/Privacy-Theater", "destination": "/blog/Privacy-Theater/index.html" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/projects/:id([a-z0-9-]+)", "destination": "/projects/:id/index.html" },
    { "source": "/ingest/static/:path(.*)", "destination": "https://us-assets.i.posthog.com/static/:path" },
    { "source": "/ingest/:path(.*)", "destination": "https://us.i.posthog.com/:path" }
  ]
}
