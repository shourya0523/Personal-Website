# All optional.
# Product analytics (PostHog). Without a key, analytics is a no-op (events still log to the console in dev).
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Deezer proxy (api/deezer.js): restrict CORS to other origins that may call it. Same-origin needs nothing.
# ALLOWED_ORIGIN=https://your-domain.example
